{
  "version": 2,
  "builds": [
    {
      "src": "ab_serve/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11",
        "includeFiles": [
          "staticfiles/**",
          "static/**",
          "templates/**",
          "Gamme/templates/**",
          "db.sqlite3"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "ab_serve/wsgi.py"
    }
  ]
}
